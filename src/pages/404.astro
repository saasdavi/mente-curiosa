---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getArticles } from '../lib/articles';
const latest = (await getArticles()).slice(0, 3);
---
<BaseLayout title="Página não encontrada" description="Esta página não existe ou foi removida." path="/404/" noindex>
  <section class="wrap">
    <h1>Página não encontrada</h1>
    <p>Esta página não existe ou foi removida. Que tal começar pela <a href="/">página inicial</a>?</p>
    {latest.length > 0 && <div class="grid">{latest.map((a) => <ArticleCard article={a} />)}</div>}
  </section>
</BaseLayout>
