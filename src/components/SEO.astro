---
// Todo o SEO técnico de <head>. Artigos e páginas só passam dados.
import { SITE } from '../config/site';

export interface SEOProps {
  title: string;
  description: string;
  /** Caminho com barra final, ex.: /por-que-sentimos-medo/ */
  path: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  path,
  image = SITE.defaultImage,
  imageAlt = SITE.name,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  jsonLd = [],
} = Astro.props as SEOProps;

if (!path.endsWith('/')) throw new Error(`Canonical sem barra final: ${path}`);

const canonical = new URL(path, SITE.url).href;
const imageUrl = new URL(image, SITE.url).href;
const fullTitle = path === '/' ? `${SITE.name} — ${SITE.tagline}` : `${title} | ${SITE.name}`;
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
{SITE.googleSiteVerification && <meta name="google-site-verification" content={SITE.googleSiteVerification} />}
{SITE.pinterestDomainVerify && <meta name="p:domain_verify" content={SITE.pinterestDomainVerify} />}

<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content={String(SITE.image.width)} />
<meta property="og:image:height" content={String(SITE.image.height)} />
<meta property="og:image:alt" content={imageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
